name = "etsy-mcp-server"
main = "build/worker.js"
compatibility_date = "2025-01-01"

# Streamable HTTP MCP endpoint. Keep this path stable for MCP clients.
[vars]
MCP_ENDPOINT = "/mcp"
ETSY_API_KEY = "replace-with-your-etsy-api-keystring"
ETSY_SHARED_SECRET = "replace-with-your-etsy-shared-secret"
ETSY_REFRESH_TOKEN = "replace-with-your-oauth-refresh-token"

# MCP_BEARER is intentionally not listed under [vars]. Configure it as a secret binding.

# Prefer Wrangler secrets for real deployments instead of committing values:
# wrangler secret put MCP_BEARER
# wrangler secret put ETSY_API_KEY
# wrangler secret put ETSY_SHARED_SECRET
# wrangler secret put ETSY_REFRESH_TOKEN

# Optional advanced token-vault mode:
# Bind a Durable Object only if your Worker entrypoint wires the api-client
# TokenVaultClient/DurableObjectTokenVault as its TokenProvider. The checked-in
# generic Worker uses ETSY_REFRESH_TOKEN directly.
# [[durable_objects.bindings]]
# name = "ETSY_TOKEN_VAULT"
# class_name = "DurableObjectTokenVault"
#
# [[migrations]]
# tag = "v1-token-vault"
# new_sqlite_classes = ["DurableObjectTokenVault"]
